# Optional. Without any of these, Baaki runs entirely on the built-in simulator and the rules brain.

# Razorpay TEST-mode keys (Dashboard → Settings → API Keys). Live keys are refused.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret you set in Dashboard → Webhooks (used to verify X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=baaki-test-webhook-secret

# --- Pick ONE LLM provider (or neither). Either way, failures fall back to the rules brain. ---

# OpenAI — for `--brain openai`
OPENAI_API_KEY=sk-...
BAAKI_OPENAI_MODEL=gpt-5

# Anthropic — for `--brain claude`
ANTHROPIC_API_KEY=sk-ant-...
BAAKI_MODEL=claude-opus-5

# --- Product deployment (see PRODUCT.md) -----------------------------------------------------
BAAKI_ENV=production                  # switches cookies to Secure
BAAKI_SECRET_KEY=                     # openssl rand -base64 32 — encrypts merchant secrets at rest
BAAKI_BASE_URL=https://app.baaki.in   # used in verification, reset and invite links
DATABASE_URL=                         # postgresql://… ; SQLite file if unset

# Outbound email (account mail + customer reminders). Console transport if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Business Cloud API. Preferred channel for customers with a phone number.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
BAAKI_WA_TEMPLATE=payment_reminder    # a Meta-approved template whose body is a single {{1}}
BAAKI_WA_TEMPLATE_LANG=en

# Platform Razorpay account, for billing merchants (not for collecting on their behalf).
BAAKI_RZP_KEY_ID=
BAAKI_RZP_KEY_SECRET=
BAAKI_RZP_PLAN_STARTER=
BAAKI_RZP_PLAN_GROWTH=
BAAKI_RZP_PLAN_SCALE=
