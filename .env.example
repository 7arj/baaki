# Optional. Without any of these, Baaki runs entirely on the built-in simulator and the rules brain.

# Razorpay TEST-mode keys (Dashboard → Settings → API Keys). Live keys are refused.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret you set in Dashboard → Webhooks (used to verify X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=baaki-test-webhook-secret

# --- Pick ONE LLM provider (or neither). Either way, failures fall back to the rules brain. ---

# OpenAI — for `--brain openai`
OPENAI_API_KEY=sk-...
BAAKI_OPENAI_MODEL=gpt-5

# Anthropic — for `--brain claude`
ANTHROPIC_API_KEY=sk-ant-...
BAAKI_MODEL=claude-opus-5
